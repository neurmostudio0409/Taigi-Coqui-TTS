# Copy to `.env` (gitignored) and fill in your real values.
# Shell env vars always win over `.env` values, so you can also export
# any of these inline for one-off runs.

# --- Data download --------------------------------------------------------
# Mozilla Data Collective API key (https://mozilladatacollective.com)
# Used by recipes/taigi/data/download_common_voice.py
MDC_API_KEY=

# --- Training recipe overrides (all optional) -----------------------------
# These override the constants in recipes/taigi/train_yourtts_taigi.py.
# Leaving them unset uses the branch-specific defaults (e.g. taigi-rtx5090
# defaults BATCH_SIZE=64, taigi defaults BATCH_SIZE=16).

# Warm-start from Coqui's YourTTS multilingual ckpt? true|false (default true)
TAIGI_FINETUNE=true

# LR multiplier applied to lr_gen / lr_disc when fine-tuning.
# 0.1 is the standard (lr 2e-4 → 2e-5). Try 0.05 for stronger preservation
# of upstream weights, or 0.2 for faster adaptation. (default 0.1)
TAIGI_LR_SCALE=0.1

# Per-GPU batch size. Override if your VRAM differs from the branch default.
# 4060 8GB → 16; 5090 32GB → 64; H200 → 96; B200 → 192.
# TAIGI_BATCH_SIZE=16

# Max audio clip length in seconds. Default 10 trims long sentences out;
# raise to 12-15 on big-VRAM GPUs to recover those samples.
# TAIGI_MAX_AUDIO_LEN=10

# Enable cuDNN auto-tuner for fastest conv kernels (5-15% speedup on H200/B200).
# Adds startup overhead so leave off for short runs / sanity checks.
# TAIGI_CUDNN_BENCHMARK=true

# Bucket sampler bin size — bigger = less padding waste / less random batches.
# 4060/5090 → 48 (default); H200 → 96; B200 → 96-192.
# TAIGI_BATCH_GROUP_SIZE=48

# Save a checkpoint every N steps. Each is ~350 MB; on disk-constrained
# cloud (e.g. Vast.ai small rootfs) raise to 10000 or 20000.
# TAIGI_SAVE_STEP=5000

# Keep N most-recent rolling checkpoints (best_model_*.pth always kept too).
# Cut to 1 to save ~350 MB per save cycle.
# TAIGI_SAVE_N_CHECKPOINTS=2

# Explicit checkpoint path to warm-start from. If set, overrides
# TAIGI_FINETUNE. Loads weights only — resets step / optimizer / LR scheduler.
# TAIGI_RESTORE_PATH=recipes/taigi/runs/YourTTS-Taigi-CV25-.../best_model.pth

# RESUME an interrupted run. Point at the run directory (NOT a .pth file).
# Coqui Trainer auto-loads the latest checkpoint + optimizer + scheduler +
# step + epoch — picks up EXACTLY where you left off (LR / progress / etc.).
# Overrides TAIGI_RESTORE_PATH and TAIGI_FINETUNE.
# TAIGI_CONTINUE_PATH=recipes/taigi/runs/YourTTS-Taigi-CV25-B200-...

# Mix in 媠聲 (Suí-siann) corpus on top of CV nan-tw? true|false (default false)
# Adds ~4.75 hr of clean Tâi-lô-labelled studio audio from a single speaker.
# Run first:
#   python recipes/taigi/data/download_suisiann.py --extract
#   python recipes/taigi/data/prepare_suisiann.py
# TAIGI_INCLUDE_SUISIANN=true
