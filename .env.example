# Copy to `.env` (gitignored) and fill in your real values.
# Shell env vars always win over `.env` values, so you can also export
# any of these inline for one-off runs.

# --- Data download --------------------------------------------------------
# Mozilla Data Collective API key (https://mozilladatacollective.com)
# Used by recipes/taigi/data/download_common_voice.py
MDC_API_KEY=

# --- Training recipe overrides (all optional) -----------------------------
# These override the constants in recipes/taigi/train_yourtts_taigi.py.
# Leaving them unset uses the branch-specific defaults (e.g. taigi-rtx5090
# defaults BATCH_SIZE=64, taigi defaults BATCH_SIZE=16).

# Warm-start from Coqui's YourTTS multilingual ckpt? true|false (default true)
TAIGI_FINETUNE=true

# LR multiplier applied to lr_gen / lr_disc when fine-tuning.
# 0.1 is the standard (lr 2e-4 → 2e-5). Try 0.05 for stronger preservation
# of upstream weights, or 0.2 for faster adaptation. (default 0.1)
TAIGI_LR_SCALE=0.1

# Per-GPU batch size. Override if your VRAM differs from the branch default.
# 4060 8GB → 16; 5090 32GB → 64; H200 → 96; B200 → 192.
# TAIGI_BATCH_SIZE=16

# Max audio clip length in seconds. Default 10 trims long sentences out;
# raise to 12-15 on big-VRAM GPUs to recover those samples.
# TAIGI_MAX_AUDIO_LEN=10

# Explicit checkpoint path to warm-start from. If set, overrides
# TAIGI_FINETUNE. Use this to resume from your own previous Taigi run.
# TAIGI_RESTORE_PATH=recipes/taigi/runs/YourTTS-Taigi-CV25-.../best_model.pth
